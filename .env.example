# ── Application ──────────────────────────────────────
DEBUG=false
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://eulerx:password@localhost:5432/eulerx_db

# ── JWT ──────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-key-at-least-32-characters-long
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Wallet Encryption ───────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WALLET_ENCRYPTION_KEY=your-fernet-key-here

# ── OpenRouter ───────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxx
OPENROUTER_MODELS=anthropic/claude-sonnet-4-20250514,openai/gpt-4o,google/gemini-2.0-flash

# ── Hyperliquid ──────────────────────────────────────
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_TESTNET=true

# ── NOWPayments ──────────────────────────────────────
NOWPAYMENTS_API_KEY=your-nowpayments-key
NOWPAYMENTS_IPN_SECRET=your-ipn-secret

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Rate Limiting ────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── Admin ────────────────────────────────────────────
# Comma-separated list of admin wallet addresses
ADMIN_WALLET_ADDRESSES=

# ── ATE ──────────────────────────────────────────────
ATE_MAX_EXECUTIONS_PER_HOUR=10
ATE_CONFIDENCE_THRESHOLD=0.6
ATE_DEFAULT_LEVERAGE=1.0
ATE_MAX_DRAWDOWN_PERCENT=10.0

# ── Subscription ─────────────────────────────────────
SUBSCRIPTION_GRACE_PERIOD_DAYS=3

# ── Redis / Celery ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540

# ── ZeptoMail / Email ─────────────────────────────
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_TOKEN=Zoho-enczapikey wSsVR61/qRKiWqh6njGkc+gwmFUHAVz/EEUs2FuovXSqGquWpsdolkbKUVWnHfUbFG9gE2Aa8bktnBhWgWcKj9gtylwJDCiF9mqRe1U4J3x17qnvhDzIVm5flBOILosIwQ9qmmJkEcxu
ZEPTOMAIL_FROM_EMAIL=noreply@eulerx.network
ZEPTOMAIL_FROM_NAME=EulerX Network
EMAIL_VERIFICATION_EXPIRY_MINUTES=30
FRONTEND_URL=https://eulerx.io

# ── Sentry ───────────────────────────────────────
SENTRY_DSN=

# ── Telegram ──────────────────────────────────────
# Telegram is per-user — each user provides their own bot token and chat ID
# via the PUT /api/v1/telegram/config endpoint. No system-level config needed.
# Optional: separate encryption key for Telegram tokens (defaults to WALLET_ENCRYPTION_KEY)
TELEGRAM_ENCRYPTION_KEY=

# ── Notification Rate Limiting ──────────────────────
NOTIFICATION_RATE_LIMIT_PER_USER=10
NOTIFICATION_RATE_LIMIT_WINDOW_SECONDS=300

# ── Analysis Pipeline ───────────────────────────────
ANALYSIS_SCHEDULE_HOURS=2
ANALYSIS_TOP_SYMBOLS_LIMIT=20
ANALYSIS_MAX_RETRIES=3
ANALYSIS_RETRY_BACKOFF=60
